---
import Base from './Base.astro';
interface Props {
  title: string;
  description: string;
  updated?: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <article class="mx-auto max-w-5xl px-4 pt-10 sm:pt-14">
    <h1 class="text-[2.1rem] leading-tight font-extrabold tracking-[-0.025em] text-ink sm:text-[2.6rem]">{title}</h1>
    {updated && <p class="mt-2 text-sm text-ink-3">Last updated {updated}</p>}
    <div class="prose-form mt-6">
      <slot />
    </div>
  </article>
</Base>
