---
/**
 * Shared frame for every tool page: heading, the tool, an ad slot after the
 * tool (never beside its buttons), how-to content, FAQ and related tools.
 * Generates WebApplication + FAQPage structured data.
 */
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import { SITE, type ToolLink } from '../lib/site';

interface Props {
  title: string;
  /** <title> override; defaults to `title`. */
  metaTitle?: string;
  description: string;
  lede: string;
  faqs: FaqItem[];
  related?: ToolLink[];
  breadcrumb?: { href: string; label: string };
}

const { title, metaTitle, description, lede, faqs, related = [], breadcrumb } = Astro.props;
const url = new URL(Astro.url.pathname.replace(/\.html$/, ''), SITE.url).href;

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    url,
    description,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires a modern web browser',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  },
];
if (faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
if (breadcrumb) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: breadcrumb.label, item: new URL(breadcrumb.href, SITE.url).href },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ],
  });
}
---

<Base title={metaTitle ?? title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 pt-8 sm:pt-12">
    {
      breadcrumb && (
        <div class="mb-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm text-ink-3">
          <a class="no-underline hover:underline" href={breadcrumb.href}>{breadcrumb.label}</a>
          <slot name="crumb-extra" />
        </div>
      )
    }
    <h1 class="max-w-[22ch] text-[2rem] leading-[1.08] font-extrabold tracking-[-0.025em] text-ink sm:text-[2.6rem]">{title}</h1>
    <p class="mt-3 max-w-[60ch] text-[1.06rem] text-ink-2">{lede}</p>
  </div>

  <div class="mx-auto mt-6 max-w-5xl px-4">
    <slot name="tool" />
  </div>

  <AdSlot />

  <div class="mx-auto max-w-5xl px-4">
    <div class="prose-form">
      <slot />
    </div>
    {faqs.length > 0 && <Faq items={faqs} />}

    {
      related.length > 0 && (
        <section aria-labelledby="related-heading" class="mt-14">
          <h2 id="related-heading" class="mb-3 text-[1.2rem] font-bold text-ink">
            Related tools
          </h2>
          <ul class="grid gap-x-8 sm:grid-cols-2">
            {related.map((t) => (
              <li class="border-b border-rule">
                <a href={t.href} class="flex min-h-[52px] flex-col justify-center py-2 no-underline">
                  <span class="font-semibold text-ink">{t.title}</span>
                  <span class="text-sm text-ink-3">{t.blurb}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
