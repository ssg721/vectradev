---
/**
 * One ad, in a frame that matches the site: a small "Advertisement" label and
 * hairline rules, with space reserved so the page doesn't jump when it loads.
 * If AdSense has no ad to show, the whole frame is hidden (see .ad in global.css).
 */
import { SITE } from '../lib/site';
import { adSlotFor, showsAd, type AdPlacement } from '../lib/ads';

interface Props {
  placement: AdPlacement;
  class?: string;
}
const { placement, class: cls } = Astro.props;
const slot = adSlotFor(placement);
const show = showsAd(placement);
const previewSize = { band: 'Responsive · fills the width', rail: '300 × 600 or 300 × 250', inline: 'Responsive · fills the width' }[placement];
---

{
  show && (
    <aside class:list={['ad', `ad-${placement}`, cls]} aria-label="Advertisement">
      <p class="ad-label">Advertisement</p>
      {slot ? (
        <>
          <ins
            class="adsbygoogle ad-unit"
            style="display:block"
            data-ad-client={SITE.adsenseClient}
            data-ad-slot={slot}
            data-ad-format="auto"
            data-full-width-responsive={placement === 'rail' ? 'false' : 'true'}
          />
          <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
        </>
      ) : (
        <div class="ad-unit ad-preview" aria-hidden="true">
          <span>Ad space</span>
          <small>{previewSize}</small>
          <small>Preview only, not shown on the live site until an ad unit is set</small>
        </div>
      )}
    </aside>
  )
}
