---
import { SITE } from '../lib/site';

/**
 * A display ad slot. Renders nothing until an ad slot id (PUBLIC_ADSENSE_SLOT) is configured, so the site launches clean and ads switch on with one env var.
 * Slots are only placed between sections, never next to upload or download buttons.
 */
interface Props {
  slot?: string;
}
const client = SITE.adsenseClient;
const slot = Astro.props.slot ?? import.meta.env.PUBLIC_ADSENSE_SLOT;
---

{
  client && slot && (
    <aside class="mx-auto my-10 max-w-5xl px-4" aria-label="Advertisement">
      <ins
        class="adsbygoogle block min-h-[100px]"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </aside>
  )
}
