---
const nav = [
  { href: '/exam', label: 'Exam photos' },
  { href: '/compress-image-to-kb', label: 'Compress' },
  { href: '/image-resizer', label: 'Resize' },
  { href: '/image-converter', label: 'Convert' },
];
const path = Astro.url.pathname.replace(/\.html$/, '');
const isActive = (href: string) => path === href || (href === '/exam' && path.startsWith('/exam'));
---

<header class="border-b border-rule bg-paper">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-8 gap-y-1 px-4 pt-3 pb-1 sm:flex-nowrap sm:py-3">
    <a href="/" class="flex items-center gap-2 py-1 text-[1.15rem] font-extrabold tracking-[-0.02em] text-ink no-underline" aria-label="vectradev home">
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
        <path d="M3 21 C 8 6, 16 6, 23 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
        <line x1="13" y1="3" x2="13" y2="12.5" stroke="var(--stamp)" stroke-width="1.6"></line>
        <rect x="10.5" y="5.5" width="5" height="5" fill="var(--paper)" stroke="var(--stamp)" stroke-width="1.6"></rect>
      </svg>
      vectradev
    </a>
    <nav aria-label="Main" class="-mx-4 w-[calc(100%+2rem)] overflow-x-auto px-4 sm:mx-0 sm:w-auto sm:px-0">
      <ul class="flex gap-1 whitespace-nowrap">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-[44px] items-center rounded-md px-2.5 text-[0.95rem] font-semibold no-underline',
                  isActive(item.href) ? 'text-ink underline decoration-stamp decoration-2 underline-offset-[6px]' : 'text-ink-2 hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
