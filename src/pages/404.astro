---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="mx-auto max-w-5xl px-4 pt-16">
    <h1 class="text-[2.4rem] font-extrabold tracking-[-0.03em] text-ink">This page doesn't exist.</h1>
    <p class="mt-3 max-w-[50ch] text-ink-2">The link may be old or mistyped. These are the tools most people are looking for:</p>
    <ul class="mt-6 max-w-md border-t border-rule">
      <li class="border-b border-rule"><a class="flex min-h-[52px] items-center font-semibold no-underline" href="/compress-image-to-kb">Compress image to any KB</a></li>
      <li class="border-b border-rule"><a class="flex min-h-[52px] items-center font-semibold no-underline" href="/exam">Exam photo and signature resizer</a></li>
      <li class="border-b border-rule"><a class="flex min-h-[52px] items-center font-semibold no-underline" href="/image-resizer">Image resizer</a></li>
      <li class="border-b border-rule"><a class="flex min-h-[52px] items-center font-semibold no-underline" href="/">Home</a></li>
    </ul>
  </section>
</Base>
