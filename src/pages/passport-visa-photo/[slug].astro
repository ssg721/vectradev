---
import { getCollection, type CollectionEntry } from 'astro:content';
import ToolPage from '../../layouts/ToolPage.astro';
import ExamTool, { describeKb, describeSize } from '../../components/tools/ExamTool';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const all = await getCollection('idPhotos');
  return all.map((e) => ({ params: { slug: e.data.slug }, props: { entry: e, all } }));
}

const { entry, all } = Astro.props as { entry: CollectionEntry<'idPhotos'>; all: CollectionEntry<'idPhotos'>[] };
const d = entry.data;
const doc = d.documents[0];
const verified = d.lastVerified.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' });
const reportHref = `mailto:${SITE.email}?subject=${encodeURIComponent(`Outdated ${d.name} photo size`)}&body=${encodeURIComponent(
  `The ${d.name} photo size on vectradev.in looks outdated.\n\nOfficial page (link):\nWhat it says now:\n`,
)}`;

const title = d.customStart ? 'Photo resizer for any passport, visa or ID' : `${d.name} photo resizer`;
const lede = d.customStart
  ? 'Enter the photo rules from your official instructions and get a JPG that matches them exactly. Nothing is uploaded.'
  : `Make a ${d.name} photo at the exact size and file size the online application accepts. Nothing is uploaded.`;
const description = d.customStart
  ? 'Crop, resize and compress a photo for any passport, visa or ID application. Enter the size in pixels or mm and the KB limit. Free, nothing uploaded.'
  : `${d.name} photo at the required pixels and KB (${[describeSize(doc), describeKb(doc)].filter(Boolean).join(', ')}). Free, works on phones, nothing is uploaded.`;

const genericFaqs = [
  { q: 'Is my photo uploaded to your server?', a: 'No. Everything runs inside your browser, on your own phone or computer. Your photo never leaves your device.' },
  ...(d.customStart
    ? []
    : [{ q: 'What if my photo is still rejected?', a: 'Compare the official instructions with the rules on this page. If they differ, tick "My official guidance says something different" and enter the new numbers. Please also tell us so we can update the preset.' }]),
];
const related = all
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ href: `/passport-visa-photo/${e.data.slug}`, title: e.data.customStart ? 'Any other passport, visa or ID photo' : `${e.data.name} photo`, blurb: e.data.fullName }));
---

<ToolPage
  title={title}
  metaTitle={d.customStart ? 'Passport, visa and ID photo resizer for any country' : `${d.name} photo size and resizer`}
  description={description}
  lede={lede}
  faqs={[...d.faqs, ...genericFaqs]}
  related={related}
  breadcrumb={{ href: '/passport-visa-photo', label: 'Passport and visa photos' }}
>
  <div slot="tool">
    {
      !d.customStart && (
        <p class="mb-5 max-w-[68ch] text-sm text-ink-3">
          Rules last checked on {verified} against{' '}
          <a href={d.source.url} rel="nofollow noopener" target="_blank" class="text-ink-2 underline underline-offset-2">{d.source.label}</a>.
          {!d.source.official && ' Rules can change, so compare with the official page before you apply.'}{' '}
          <a href={reportHref} class="text-ink-2 underline underline-offset-2">Report an outdated size</a>
        </p>
      )
    }
    <ExamTool client:load examName={d.name} documents={d.documents} ruleSource="official guidance" customStart={d.customStart} />
  </div>

  <p>{d.intro}</p>
  {d.covers.length > 0 && <p>{d.customStart ? 'Works for' : 'Use it for'} {d.covers.join(', ').replace(/, ([^,]*)$/, ' and $1')}.</p>}

  {
    !d.customStart && (
      <>
        <h2>{d.name} photo requirements</h2>
        <div class="-mx-4 overflow-x-auto px-4">
          <table class="w-full min-w-[420px] border-collapse text-left text-[0.95rem]">
            <tbody>
              <tr class="border-b border-rule"><th scope="row" class="w-40 py-2 pr-4 font-semibold text-ink">File size</th><td class="tabular py-2">{describeKb(doc)}</td></tr>
              <tr class="border-b border-rule"><th scope="row" class="py-2 pr-4 font-semibold text-ink">Size</th><td class="tabular py-2">{describeSize(doc) || 'Not fixed'}{doc.dpi ? `, ${doc.dpi} DPI` : ''}</td></tr>
              <tr class="border-b border-rule"><th scope="row" class="py-2 pr-4 font-semibold text-ink">Format</th><td class="py-2">JPG</td></tr>
            </tbody>
          </table>
        </div>
        <ul>{doc.notes.map((n) => <li>{n}</li>)}</ul>
      </>
    )
  }

  <h2>How to make your photo</h2>
  <ol>
    <li>Stand against a plain, light wall in even daylight, facing the camera. Ask someone to take the photo from about 1.5 metres away, rather than taking a selfie.</li>
    {d.customStart && <li>Enter the size and KB range from your application's instructions.</li>}
    <li>Choose the photo here and drag it so your face sits inside the guide.</li>
    <li>Check the result and download the JPG, then upload it to your application.</li>
  </ol>
</ToolPage>
