---
import ToolPage from '../layouts/ToolPage.astro';
import { PDF_GROUPS } from '../lib/site';

const faqs = [
  { q: 'Are my PDFs uploaded?', a: 'No. Every PDF tool on vectradev runs inside your browser, so your documents never leave your device.' },
  { q: 'Which PDF tools are available?', a: 'You can compress a PDF by quality or to a size limit such as 100 KB, 200 KB, 500 KB or 1 MB, and combine photos or scans into one PDF in the order you choose. More PDF tools are being added.' },
];
---

<ToolPage
  title="PDF tools"
  metaTitle="Free PDF tools that work in your browser (no upload)"
  description="Compress PDFs to the size your form asks for and turn images into a PDF, privately in your browser. Nothing is uploaded."
  lede="Get documents and certificates ready for upload. Everything runs on your device."
  faqs={faqs}
>
  <div slot="tool" class="grid gap-10 sm:grid-cols-2">
    {
      PDF_GROUPS.map((g) => (
        <section>
          <h2 class="mb-2 text-sm font-bold text-ink-2">{g.title}</h2>
          <ul class="border-t border-rule">
            {g.tools.map((t) => (
              <li class="border-b border-rule">
                <a href={t.href} class="flex min-h-[56px] flex-col justify-center py-1.5 no-underline">
                  <span class="font-semibold text-ink">{t.title}</span>
                  <span class="text-sm text-ink-3">{t.blurb}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <h2>Private by design</h2>
  <p>
    Most PDF websites upload your file to their servers to process it. Here, the PDF is opened and rebuilt inside your browser, so certificates, ID proofs and statements stay on your device.
  </p>
</ToolPage>
