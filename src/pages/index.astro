---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import HeroTool from '../components/tools/HeroTool';
import { describeKb, describeSize } from '../components/tools/ExamTool';
import { SITE, IMAGE_TOOLS, COMPRESS_TOOLS, PDF_GROUPS } from '../lib/site';

const exams = (await getCollection('exams')).sort((a, b) => a.data.order - b.data.order);
const idPhotos = (await getCollection('idPhotos')).sort((a, b) => a.data.order - b.data.order);
const kb = (e: (typeof exams)[number], kind: string) => {
  const d = e.data.documents.find((x) => x.kind === kind);
  return !d ? null : d.liveCapture ? 'live camera' : describeKb(d);
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: 'Free photo and image tools that run in your browser: compress to KB, exam and passport photo resizer, image resizer and converter.',
  },
];

const listHeading = 'text-[1.6rem] font-extrabold tracking-[-0.02em] text-ink';
---

<Base
  title={`vectradev: ${SITE.tagline.toLowerCase()}`}
  description="Free photo and PDF tools that work on your phone: compress photos and PDFs to any KB, exam photo and signature resizer, passport and visa photos, resizer and converter. Nothing is uploaded."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-4 pt-10 sm:pt-16">
    <h1 class="max-w-[14ch] text-[2.5rem] leading-[1.02] font-extrabold tracking-[-0.035em] text-ink sm:text-[3.6rem]">
      Make your files fit the form.
    </h1>
    <p class="mt-4 max-w-[52ch] text-[1.1rem] text-ink-2">
      Compress, resize and convert photos, signatures and PDFs for exam, visa, passport and job applications.
    </p>
    <p class="mt-4 flex max-w-[60ch] items-start gap-2.5 text-[0.98rem] text-ink">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" class="mt-0.5 shrink-0 text-stamp">
        <rect x="4" y="9" width="12" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M7 9V6.5a3 3 0 016 0V9" fill="none" stroke="currentColor" stroke-width="1.8" />
      </svg>
      <span>
        <strong class="font-bold">Your files never leave your device.</strong> Everything happens in your browser.{' '}
        <a href="#privacy" class="text-ink-2 underline underline-offset-2">How you can check</a>
      </span>
    </p>
  </section>

  <section class="mx-auto mt-8 max-w-5xl px-4" aria-label="Compress a photo or PDF">
    <HeroTool client:load />
  </section>

  <section class="mx-auto mt-16 max-w-5xl px-4" aria-labelledby="tools-heading">
    <h2 id="tools-heading" class={listHeading}>Image tools</h2>
    <div class="mt-5 grid gap-10 sm:grid-cols-2">
      <div>
        <h3 class="mb-2 text-sm font-bold text-ink-2">Compress to a size</h3>
        <ul class="border-t border-rule">
          {
            COMPRESS_TOOLS.map((t) => (
              <li class="border-b border-rule">
                <a href={t.href} class="flex min-h-[48px] items-center justify-between gap-3 py-1.5 no-underline">
                  <span class="font-semibold text-ink">{t.title}</span>
                  <span class="hidden text-sm text-ink-3 md:block">{t.blurb}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="mb-2 text-sm font-bold text-ink-2">Resize and convert</h3>
        <ul class="border-t border-rule">
          {
            IMAGE_TOOLS.map((t) => (
              <li class="border-b border-rule">
                <a href={t.href} class="flex min-h-[48px] items-center py-1.5 font-semibold text-ink no-underline">{t.title}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-5xl px-4" aria-labelledby="pdf-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h2 id="pdf-heading" class={listHeading}>PDF tools</h2>
      <a href="/pdf-tools" class="text-[0.95rem] font-semibold text-ink-2 underline underline-offset-4">All PDF tools</a>
    </div>
    <div class="mt-5 grid gap-10 sm:grid-cols-2">
      {
        PDF_GROUPS.map((g) => (
          <div>
            <h3 class="mb-2 text-sm font-bold text-ink-2">{g.title}</h3>
            <ul class="border-t border-rule">
              {g.tools.map((t) => (
                <li class="border-b border-rule">
                  <a href={t.href} class="flex min-h-[56px] flex-col justify-center py-1.5 no-underline">
                    <span class="font-semibold text-ink">{t.title}</span>
                    <span class="text-sm text-ink-3">{t.blurb}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-5xl px-4" aria-labelledby="exams-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h2 id="exams-heading" class={listHeading}>Filling an exam form?</h2>
      <a href="/exam" class="text-[0.95rem] font-semibold text-ink-2 underline underline-offset-4">All {exams.length} exams</a>
    </div>
    <p class="mt-1 max-w-[60ch] text-ink-2">These pages already know the pixel size and KB range for every document the form asks for.</p>
    <ul class="mt-5 grid border-t border-rule sm:grid-cols-2 sm:gap-x-10">
      {
        exams.slice(0, 8).map((e) => (
          <li class="border-b border-rule">
            <a href={`/exam/${e.data.slug}`} class="group flex min-h-[64px] items-center justify-between gap-4 py-2 no-underline">
              <span>
                <span class="block font-bold text-ink group-hover:underline">{e.data.name}</span>
                <span class="tabular block text-sm text-ink-3">
                  Photo: {kb(e, 'photo')}
                  {kb(e, 'signature') && `, signature: ${kb(e, 'signature')}`}
                </span>
              </span>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="shrink-0 text-ink-3">
                <path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <AdSlot placement="band" />

  <section class="mx-auto mt-16 max-w-5xl px-4" aria-labelledby="id-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h2 id="id-heading" class={listHeading}>Passport or visa photo?</h2>
      <a href="/passport-visa-photo" class="text-[0.95rem] font-semibold text-ink-2 underline underline-offset-4">All passport and visa photos</a>
    </div>
    <p class="mt-1 max-w-[60ch] text-ink-2">Get the exact photo and file size an online application accepts, with step-by-step guides for visas to Bali, Vietnam, Thailand and the Maldives.</p>
    <ul class="mt-5 grid border-t border-rule sm:grid-cols-2 sm:gap-x-10">
      {
        idPhotos.map((e) => (
          <li class="border-b border-rule">
            <a href={`/passport-visa-photo/${e.data.slug}`} class="group flex min-h-[64px] items-center justify-between gap-4 py-2 no-underline">
              <span>
                <span class="block font-bold text-ink group-hover:underline">{e.data.customStart ? 'Any other document' : e.data.name}</span>
                <span class="tabular block text-sm text-ink-3">
                  {e.data.customStart
                    ? 'Other visas, ID cards, residence permits'
                    : e.data.documents.length
                      ? [describeSize(e.data.documents[0]), describeKb(e.data.documents[0])].filter(Boolean).join(', ')
                      : 'No photo needed: free visa on arrival'}
                </span>
              </span>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="shrink-0 text-ink-3">
                <path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="privacy" class="mx-auto mt-16 max-w-5xl scroll-mt-6 px-4" aria-labelledby="private-heading">
    <div class="max-w-[64ch] border-l-[3px] border-stamp pl-5">
      <h2 id="private-heading" class="text-[1.25rem] font-bold text-ink">Your files stay with you</h2>
      <p class="mt-2 text-ink-2">
        Most online tools send your files to a server. Here, the work happens inside your browser, so your photo, signature, ID or PDF never leaves your device. You don't have to take our word for it:
      </p>
      <ul class="mt-3 list-disc space-y-1.5 pl-5 text-ink-2">
        <li>
          <strong class="text-ink">Try it offline.</strong> Open a tool, turn off Wi-Fi and mobile data, then choose a JPG or PNG photo. It still works, because nothing needs to be sent anywhere.
        </li>
        <li>
          <strong class="text-ink">Read the code.</strong> The whole site is public on <a href={SITE.repo} rel="noopener" class="text-stamp underline underline-offset-2">GitHub</a>, so anyone can check that files are never uploaded.
        </li>
      </ul>
    </div>
  </section>
</Base>
