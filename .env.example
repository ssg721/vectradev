# Optional. Leave empty to keep the feature off.
PUBLIC_CF_ANALYTICS_TOKEN=
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=
# Optional second ad unit for the side column on wide screens (falls back to PUBLIC_ADSENSE_SLOT).
PUBLIC_ADSENSE_SLOT_SIDE=
# Set to 1 to show labelled ad placeholders in a production build (they always show in npm run dev).
PUBLIC_AD_PREVIEW=
